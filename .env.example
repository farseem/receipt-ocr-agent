# Environment variables for OCR Agent

# Google Cloud Vision API Configuration
# Option 1: Use API Key (recommended for simplicity)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
GOOGLE_VISION_API_URL=https://vision.googleapis.com/v1/images:annotate
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# Option 2: Use Service Account JSON (alternative, more secure for production)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json

# OpenRouter API Configuration (for LLM field extraction)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Optional: Gemini API Configuration (alternative LLM)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# Directory Configuration
WATCH_FOLDER=./data/input
PROCESSED_FOLDER=./data/processed

# Database Configuration
DATABASE_PATH=./data/storage/invoice_data.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/ocr_agent.log

# Processing Configuration
MAX_FILE_SIZE_MB=10
MIN_CONFIDENCE=0.7
OCR_CONFIDENCE_THRESHOLD=0.9
